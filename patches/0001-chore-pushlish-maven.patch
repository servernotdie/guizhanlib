Subject: [PATCH 1/2] chore pushlish maven

---
 .github/workflows/ci.yml | 45 ++++++++++++++++++++++++++--------------
 1 file changed, 30 insertions(+), 15 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 8ea39d6..85028d2 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,10 +1,9 @@
 name: CI
-
 on:
   workflow_dispatch:
   push:
     branches:
-      - master
+      - main
     paths:
       - '*.java'
       - 'build.gradle.kts'
@@ -12,45 +11,61 @@ on:
       - 'gradle.properties'
   pull_request:
     branches:
-      - master
+      - main
     paths:
       - '*.java'
       - 'build.gradle.kts'
       - 'settings.gradle.kts'
       - 'gradle.properties'
-
 jobs:
   build:
     runs-on: ubuntu-latest
+    permissions:
+      contents: write
     steps:
       - name: Checkout repository
         uses: actions/checkout@v4
-
       - name: Set up JDK 21
         uses: actions/setup-java@v4
         with:
           java-version: 21
           distribution: temurin
-
       - name: Setup Gradle
         uses: gradle/actions/setup-gradle@v4
-
       - name: Build with Gradle
         run: ./gradlew clean shadowJar
-
       - name: Select jar
         run: |
           cd guizhanlib-all/build/libs
           echo "FILE=$(ls | grep jar)" >> $GITHUB_ENV
-
-      - name: Publish to repo
-        run: ./gradlew publish
-        env:
-          MAVEN_ACCOUNT: '${{ secrets.MAVEN_ACCOUNT }}'
-          MAVEN_PASSWORD: '${{ secrets.MAVEN_PASSWORD }}'
-
       - name: Upload Artifact
         uses: actions/upload-artifact@v4
         with:
           name: ${{ env.FILE }}
           path: guizhanlib-all/build/libs/${{ env.FILE }}
+
+      - name: Generate tag
+        if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
+        run: |
+          TAG="build-${{ github.run_number }}"
+          echo "TAG=$TAG" >> $GITHUB_ENV
+
+      - name: Create tag
+        if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+          git tag ${{ env.TAG }}
+          git push origin ${{ env.TAG }}
+
+      - name: Create Release
+        if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ${{ env.TAG }}
+          name: ${{ env.TAG }}
+          files: guizhanlib-all/build/libs/${{ env.FILE }}
+          generate_release_notes: true
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          
\ No newline at end of file
